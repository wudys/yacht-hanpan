# Set these in Render's service environment. Replace placeholders before deployment.
NODE_ENV=production
# Render supplies PORT and RENDER=true; the server binds to 0.0.0.0 automatically.
ALLOWED_WEB_ORIGINS=https://replace-web.invalid
# Only the Render runtime trusts its public edge client-IP header.
# Room cleanup runs automatically inside the server.
# Error collection is opt-in and independent of production or preview mode.
SENTRY_ENABLED=false
