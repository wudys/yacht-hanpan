# Set these in the manual build environment (GitHub Actions); do not copy into .env.local.
# Replace placeholders before deployment. Browser settings are fixed at build time.
VITE_GAME_SERVER_URL=https://replace-server.invalid
VITE_SITE_ORIGIN=https://replace-site.invalid
VITE_DEPLOYMENT_ENV=production
# VITE_SITE_ORIGIN is the public web origin, without a path or trailing slash.
# Metadata and browser telemetry use the same build-time origin.
# Public GA/Sentry IDs and source-map project are code settings:
# src/runtime/telemetry/telemetry-config.ts
# The only Sentry secret is supplied by the build platform (never a VITE_* value):
# SENTRY_AUTH_TOKEN=<private source-map upload token>
# For Pages preview: VITE_DEPLOYMENT_ENV=preview and an HTTPS test server
# with a matching release. Public telemetry settings are ignored in preview.
