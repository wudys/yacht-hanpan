{
  "name": "@repo/game-client-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "default": "./src/errors/index.ts"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "default": "./src/http/index.ts"
    },
    "./session": {
      "types": "./src/session/index.ts",
      "default": "./src/session/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/game-protocol": "workspace:*",
    "socket.io-client": "4.8.4",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "^1.4.2",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3"
  }
}
